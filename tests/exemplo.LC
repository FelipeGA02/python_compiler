inicio exemplo_completo ;

/* ================================================================
   PROGRAMA DE TESTE COMPLETO — Linguagem BRL
   Cobre todos os construtos validos da especificacao:
     - Todos os 4 tipos de variaveis
     - Declaracao individual e multi-ID
     - Todos os operadores (aritmeticos, logicos, relacionais, unarios)
     - Precedencia e parenteses
     - Todas as instrucoes (atrib, se, enquanto, leia, escreva)
     - Concatenacao de strings
     - Promocao implicita inteiro -> real
     - Comentarios simples e de multiplas linhas
     - Identificadores com letras, digitos e sublinhado
   ================================================================ */

/* ----------------------------------------------------------------
   SECAO 1 — DECLARACOES
   Regra: id [, id] : tipo ;
   Testa declaracao individual e multi-ID para cada tipo
   ---------------------------------------------------------------- */

/* 1a. tipo inteiro — individual */
a         : inteiro ;
b         : inteiro ;
soma      : inteiro ;
produto   : inteiro ;
quociente : inteiro ;
resto     : inteiro ;
contador  : inteiro ;

/* 1b. tipo inteiro — multi-ID na mesma declaracao */
i , n , c : inteiro ;

/* 1c. tipo real — individual */
pi   : real ;
raio : real ;
area : real ;

/* 1d. tipo real — multi-ID */
x_real , y_real , media : real ;

/* 1e. tipo logico — individual */
ativo     : logico ;
encontrou : logico ;
par       : logico ;

/* 1f. tipo logico — multi-ID */
cond , flag1 , flag2 : logico ;

/* 1g. tipo caractere — individual */
msg1 : caractere ;
msg2 : caractere ;

/* 1h. tipo caractere — multi-ID + ID com sublinhado e digito */
nome , _var1 , str_aux : caractere ;

/* ----------------------------------------------------------------
   SECAO 2 — ATRIBUICOES DE CONSTANTES
   Regra: id := EXP ;
   Testa CONST_INT, CONST_REAL, CONST_BOOL, CONST_STRING
   ---------------------------------------------------------------- */

/* 2a. constantes inteiras (CONST_INT) */
a        := 36 ;
b        := 24 ;
c        := 0 ;
i        := 1 ;
n        := 10 ;
contador := 0 ;
soma     := 0 ;
produto  := 1 ;

/* 2b. constantes reais (CONST_REAL: digito . digito obrigatorio) */
pi   := 3.14159 ;
raio := 5.0 ;

/* 2c. constantes logicas: verdadeiro e falso */
ativo     := verdadeiro ;
encontrou := falso ;
flag1     := verdadeiro ;
flag2     := falso ;

/* 2d. constantes caractere (CONST_STRING) — chars validos da spec */
msg1    := "Ola, mundo! Teste BRL 2026." ;
msg2    := "linha-2: result=OK; path=/tmp" ;
nome    := "BRL_compilador_v1" ;
_var1   := "ID com sublinhado inicial" ;
str_aux := "chars: .,;:()[]{}+-*/|!?<>=" ;

/* ----------------------------------------------------------------
   SECAO 3 — OPERADORES ARITMETICOS
   Precedencia: (* / div mod &&) > (+ - ou) > (relops)
   ---------------------------------------------------------------- */

/* 3a. adição, subtração */
soma := a + b ;
c    := a - b ;

/* 3b. multiplicacao */
produto := a * b ;

/* 3c. divisao real (/ em inteiro -> inteiro no nosso tipo) */
quociente := a / b ;

/* 3d. divisao inteira e modulo (div e mod requerem inteiro) */
quociente := a div b ;
resto     := a mod b ;

/* 3e. operadores sobre real */
area  := pi * raio * raio ;
media := pi / raio ;

/* 3f. expressao mista: inteiro op inteiro op inteiro */
soma := a + b + c + n ;

/* ----------------------------------------------------------------
   SECAO 4 — PROMOCAO IMPLICITA inteiro -> real
   Valida: real := inteiro  (promocao)
   Invalida: inteiro := real  (testada no script de erros)
   ---------------------------------------------------------------- */

x_real := a ;       /* inteiro atribuido a real: promocao valida */
y_real := 3 ;       /* CONST_INT atribuida a real: valido */
media  := a + b ;   /* inteiro + inteiro -> inteiro; promovido para real */

/* ----------------------------------------------------------------
   SECAO 5 — OPERADORES UNARIOS
   Regra: not <exp_un> | + <exp_un> | - <exp_un>
   ---------------------------------------------------------------- */

soma  := - a ;          /* unario - em inteiro */
soma  := + b ;          /* unario + em inteiro */
media := - pi ;         /* unario - em real */
cond  := not flag1 ;    /* not em logico */
cond  := not ( flag1 && flag2 ) ;   /* not sobre expressao parentesada */

/* ----------------------------------------------------------------
   SECAO 6 — OPERADORES LOGICOS (&&  ou)
   Ambos os operandos devem ser logico -> resultado logico
   ---------------------------------------------------------------- */

cond := flag1 && flag2 ;
cond := flag1 ou flag2 ;
cond := not flag1 && ativo ;      /* (not flag1) && ativo */
cond := flag1 ou flag2 && ativo ; /* flag1 ou (flag2 && ativo) */

/* ----------------------------------------------------------------
   SECAO 7 — OPERADORES RELACIONAIS (todos os 6)
   Resultado sempre logico
   ---------------------------------------------------------------- */

/* 7a. sobre inteiro */
cond := a == b ;
cond := a <> b ;
cond := a <  b ;
cond := a >  b ;
cond := a <= b ;
cond := a >= b ;

/* 7b. sobre real */
cond := pi >  raio ;
cond := pi <= media ;
cond := pi == media ;
cond := raio <> area ;

/* 7c. sobre caractere (== e <> validos; < > <= >= tambem pelo semantico) */
cond := msg1 == msg2 ;
cond := msg1 <> msg2 ;

/* ----------------------------------------------------------------
   SECAO 8 — CONCATENACAO DE STRINGS (+)
   caractere + caractere -> caractere
   ---------------------------------------------------------------- */

nome    := msg1 + msg2 ;
str_aux := msg1 + " | " + msg2 ;

/* ----------------------------------------------------------------
   SECAO 9 — PRECEDENCIA E PARENTESES
   ---------------------------------------------------------------- */

soma    := ( a + b ) * c ;
soma    := a + ( b * c ) ;
soma    := ( a + b ) * ( a - b ) ;
soma    := a * b + c * n ;             /* sem paren: * antes de + */
cond    := ( a + b ) >= ( c + n ) ;
cond    := not ( flag1 ou flag2 ) ;
produto := ( a + b ) * ( a + b ) ;

/* ----------------------------------------------------------------
   SECAO 10 — INSTRUCAO leia
   Formato: leia ( id [, id] )
   ---------------------------------------------------------------- */

leia ( a ) ;                     /* variavel unica — inteiro */
leia ( b , c ) ;                 /* dois inteiros */
leia ( i , n , contador ) ;      /* tres inteiros */
leia ( pi ) ;                    /* real */
leia ( flag1 ) ;                 /* logico */
leia ( msg1 ) ;                  /* caractere */
leia ( x_real , y_real ) ;       /* dois reais */

/* ----------------------------------------------------------------
   SECAO 11 — INSTRUCAO escreva
   Formato: escreva ( EXP )  — aceita qualquer expressao
   ---------------------------------------------------------------- */

escreva ( a ) ;                       /* variavel inteiro */
escreva ( pi ) ;                      /* variavel real */
escreva ( flag1 ) ;                   /* variavel logico */
escreva ( msg1 ) ;                    /* variavel caractere */
escreva ( a + b ) ;                   /* expressao inteiro */
escreva ( pi * raio ) ;               /* expressao real */
escreva ( a == b ) ;                  /* expressao logico */
escreva ( msg1 + msg2 ) ;             /* concatenacao */
escreva ( "string literal direta" ) ; /* CONST_STRING direta */
escreva ( 42 ) ;                      /* CONST_INT direta */
escreva ( 3.14 ) ;                    /* CONST_REAL direta */
escreva ( verdadeiro ) ;              /* CONST_BOOL direta */
escreva ( falso ) ;                   /* CONST_BOOL direta */
escreva ( - a ) ;                     /* unario em expressao */
escreva ( not flag1 ) ;               /* not em expressao */
escreva ( ( a + b ) * c ) ;           /* expressao com parenteses */

/* ----------------------------------------------------------------
   SECAO 12 — INSTRUCAO se (sem senao)
   Formato: se EXP entao inicio instrucoes fim
   ---------------------------------------------------------------- */

se a == b entao
inicio
    escreva ( "a igual a b" )
fim ;

se a <> b entao
inicio
    escreva ( "a diferente de b" )
fim ;

se ativo entao
inicio
    escreva ( "ativo verdadeiro" )
fim ;

/* ----------------------------------------------------------------
   SECAO 13 — INSTRUCAO se-senao
   Formato: se EXP entao inicio ... fim senao inicio ... fim
   ---------------------------------------------------------------- */

se a >= b entao
inicio
    escreva ( "a maior ou igual a b" )
fim
senao
inicio
    escreva ( "b maior que a" )
fim ;

se flag1 && flag2 entao
inicio
    escreva ( "ambos verdadeiros" )
fim
senao
inicio
    escreva ( "pelo menos um falso" )
fim ;

/* ----------------------------------------------------------------
   SECAO 14 — se ANINHADO (3 niveis)
   ---------------------------------------------------------------- */

se a > 100 entao
inicio
    escreva ( "grande" )
fim
senao
inicio
    se a > 10 entao
    inicio
        escreva ( "medio" )
    fim
    senao
    inicio
        se a > 0 entao
        inicio
            escreva ( "pequeno" )
        fim
        senao
        inicio
            escreva ( "zero ou negativo" )
        fim
    fim
fim ;

/* ----------------------------------------------------------------
   SECAO 15 — INSTRUCAO enquanto (basico)
   Formato: enquanto EXP faca inicio instrucoes fim
   ---------------------------------------------------------------- */

i    := 1 ;
soma := 0 ;

enquanto i <= n faca
inicio
    soma := soma + i ;
    i    := i + 1
fim ;

escreva ( soma ) ;

/* ----------------------------------------------------------------
   SECAO 16 — enquanto com condicional interna
   ---------------------------------------------------------------- */

i        := 1 ;
contador := 0 ;
par      := falso ;

enquanto i <= 20 faca
inicio
    resto := i mod 2 ;
    se resto == 0 entao
    inicio
        par      := verdadeiro ;
        contador := contador + 1
    fim
    senao
    inicio
        par := falso
    fim ;
    i := i + 1
fim ;

escreva ( contador ) ;

/* ----------------------------------------------------------------
   SECAO 17 — LACOS ANINHADOS
   ---------------------------------------------------------------- */

i := 1 ;

enquanto i <= 3 faca
inicio
    n := 1 ;
    enquanto n <= 3 faca
    inicio
        produto := i * n ;
        escreva ( produto ) ;
        n := n + 1
    fim ;
    i := i + 1
fim ;

/* ----------------------------------------------------------------
   SECAO 18 — EXPRESSAO COMPLEXA NA CONDICAO
   ---------------------------------------------------------------- */

se ( a + b ) > ( n * 2 ) entao
inicio
    escreva ( "soma maior que dobro de n" )
fim ;

enquanto not encontrou faca
inicio
    escreva ( "buscando..." ) ;
    encontrou := verdadeiro
fim ;

/* ----------------------------------------------------------------
   SECAO 19 — COMENTARIO DE MULTIPLAS LINHAS
   Testa que o lexer ignora corretamente blocos de comentario
   que abrangem multiplas linhas
   ---------------------------------------------------------------- */

/* Este bloco de comentario
   abrange varias linhas
   e deve ser ignorado pelo lexer
   sem interferir nos tokens seguintes */

escreva ( "apos comentario multi-linha" ) ;

/* ----------------------------------------------------------------
   SECAO 20 — VERIFICACAO DE CASE SENSITIVITY
   Identificadores com mesmo nome mas capitalizacao diferente
   devem ser tratados como variaveis distintas (sensitive-case)
   ---------------------------------------------------------------- */

escreva ( msg1 ) ;
escreva ( msg2 )

fim
